msgid "slider"
msgstr "slider"

#: build/carousel/block.json
msgctxt "block keyword"
msgid "slideshow"
msgstr "diaporama"

#: build/carousel/block.json
msgctxt "block keyword"
msgid "scroll"
msgstr "défilement"

#: build/slide/block.json
msgctxt "block title"
msgid "Carousel slide"
msgstr "Diapositive de carrousel"

#: build/slide/block.json
msgctxt "block description"
msgid "Wrap any blocks into a single carousel slide. Needed for slides made of groups or columns inside a locked pattern."
msgstr "Regroupe des blocs dans une seule diapositive. Nécessaire pour les diapositives faites de groupes ou de colonnes dans une composition verrouillée."

#: build/slide/block.json
msgctxt "block keyword"
msgid "slide"
msgstr "diapositive"
