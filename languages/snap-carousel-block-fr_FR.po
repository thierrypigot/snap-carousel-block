#: build/carousel/block.json
msgctxt "block title"
msgid "Snap carousel"
msgstr "Carrousel défilant"

#: build/carousel/block.json
msgctxt "block description"
msgid "Display any blocks placed inside as an accessible horizontal carousel. Also works with a single Query Loop or Gallery."
msgstr "Affiche tous les blocs placés à l’intérieur dans un carrousel horizontal accessible. Fonctionne aussi avec une seule Boucle de requête ou Galerie."

#: build/carousel/block.json
#: build/slide/block.json
